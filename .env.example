# Local checkpoint path. The app downloads MODEL_URL only when this file is missing.
MODEL_PATH=artifacts/conditioned-best.pt

# Public, version-pinned GitHub Release URL for the trained checkpoint.
MODEL_URL=

# Strongly recommended: SHA-256 digest of the release checkpoint.
MODEL_SHA256=

# Public repository URL shown in the app header.
GITHUB_REPOSITORY_URL=

# Canonical Render origin, for example https://motif-piano-generator.onrender.com
PUBLIC_BASE_URL=
